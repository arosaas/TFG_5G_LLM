# gNB Configuration para Baja Latencia
# Esta configuración asume un gNB (ej. srsRAN gNB) que se conecta a un core Open5GS.
# Los parámetros de la red core (AMF, UPF, PLMN ID, etc.) se han extraído del contexto RAG.

amf:
  amf_address: 127.0.3.5 # Extraído de 'amf.ngap.server.address' en el contexto RAG
  amf_port: 38412 # Puerto NGAP estándar
  amf_name: open5gs-amf0 # Extraído de 'amf.amf_name' en el contexto RAG
  amf_id:
    region: 2 # Extraído de 'amf.guami.amf_id.region' en el contexto RAG
    set: 1    # Extraído de 'amf.guami.amf_id.set' en el contexto RAG

gnb:
  gnb_id: 0x1999 # REVISAR: gNB ID asumido. Debe ser único en la red.
  gnb_name: srsgnb-low-latency # Nombre descriptivo para el gNB
  tac: 1 # Extraído de 'amf.tai.tac' en el contexto RAG
  plmn_id:
    mcc: 315 # Extraído de 'amf.guami.plmn_id.mcc' en el contexto RAG
    mnc: 010 # Extraído de 'amf.guami.plmn_id.mnc' en el contexto RAG
  ngap_bind_address: 127.0.0.1 # REVISAR: IP del gNB para la interfaz N2 (control plane). Valor asumido.
  gtpu_bind_address: 127.0.0.1 # REVISAR: IP del gNB para la interfaz N3 (user plane). Valor asumido.

cell_cfg:
  # Parámetros de la celda NR. Estos son ejemplos y deben ajustarse al despliegue físico.
  dl_nr_arfcn: 630000 # REVISAR: NR-ARFCN para la banda n78 (ejemplo). Ajustar según la banda y frecuencia real.
  band: 78 # REVISAR: Banda NR. Ajustar según el despliegue.
  ssb_subcarrier_spacing: 30 # kHz. REVISAR: Espaciado de subportadoras SSB. Común para n78.
  ssb_periodicity: 20 # ms. REVISAR: Periodicidad del SSB.
  ssb_offset: 0 # REVISAR: Offset del SSB.
  ssb_power: 20 # dBm. REVISAR: Potencia del SSB.
  rach_root_sequence_index: 100 # REVISAR: Índice de secuencia raíz RACH.
  prach_config_index: 0 # REVISAR: Índice de configuración PRACH.
  prach_frequency_offset: 0 # REVISAR: Offset de frecuencia PRACH.

  # Para lograr baja latencia, se recomienda:
  # 1. Configurar un 5QI de baja latencia (ej. 5QI 80 para URLLC) en el SMF del core.
  # 2. Asegurar que el gNB tenga políticas de planificación de recursos (scheduling)
  #    que prioricen el tráfico con este 5QI, minimizando el retardo de cola y el tiempo de procesamiento.
  # 3. Considerar el uso de TTI-bundling o mini-slots si el hardware del gNB lo soporta.
  # Estos parámetros específicos del gNB para QoS y scheduling no se pueden inferir del contexto RAG proporcionado.

slice_list:
  - sst: 1 # Extraído de 'amf.plmn_support.s_nssai.sst' en el contexto RAG
    sd: 0x000001 # REVISAR: SD (Slice Differentiator) asumido. No especificado en el contexto.
    # Para baja latencia, se podría definir un slice dedicado con características específicas de QoS.

upf:
  upf_address: 127.0.0.7 # Extraído de 'upf.pfcp.server.address' en el contexto RAG
  upf_port: 2152 # Puerto PFCP estándar